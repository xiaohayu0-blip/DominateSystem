ENVIRONMENT=production
POSTGRES_DB=dominate
POSTGRES_USER=dominate
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql+psycopg://dominate:REPLACE_WITH_A_LONG_RANDOM_PASSWORD@db:5432/dominate
STORAGE_DIR=/data/files
PUBLIC_ORIGIN=https://REPLACE_WITH_YOUR_DOMAIN
SECURE_COOKIES=true
MODEL_MODE=deepseek
MATERIAL_MODE=official
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
MODEL_TIMEOUT_SECONDS=25
MODEL_CONCURRENCY=2
MODEL_DAILY_LIMIT=500
MAIL_MODE=smtp
WEEKLY_MAIL_ENABLED=true
WEEKLY_RECIPIENT=
ALLOW_REAL_EMAIL=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_RECIPIENT=
OCR_ENABLED=false
WEB_PORT=8080
